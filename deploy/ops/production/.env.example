# Production runtime configuration for XDD API.
# bootstrap-server.sh copies this file to .env and fills generated secrets.
# Never commit the real .env.

PUBLIC_DOMAIN=api.xddapi.org.uk
PAYMENT_DOMAIN=pay.xddapi.org.uk
TZ=Asia/Shanghai
SERVER_MODE=release
RUN_MODE=standard
SERVER_FRONTEND_URL=https://api.xddapi.org.uk
SERVER_TRUSTED_PROXIES=172.30.0.10/32
SECURITY_TRUST_FORWARDED_IP_FOR_API_KEY_ACL=false

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=300
DATABASE_MAX_OPEN_CONNS=200
DATABASE_MAX_IDLE_CONNS=80
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=32

ADMIN_EMAIL=admin@xddapi.org.uk
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=

# Sub2API -> Bridge integration.
# Generate a dedicated admin API key in Sub2API after the first deployment and
# save it here. The Bridge deliberately accepts paid orders until this exists.
BRIDGE_PUBLIC_URL=https://api.xddapi.org.uk
SUB2API_ADMIN_API_KEY=
BRIDGE_ADMIN_TOKEN=
BRIDGE_SUPPORT_URL=
BRIDGE_SUPPORT_LABEL=联系客服
BRIDGE_POLL_INTERVAL=20s
BRIDGE_REQUEST_TIMEOUT=20s
BRIDGE_CALLBACK_MAX_SKEW=60s
BRIDGE_CREDIT_RETRY_BACKOFF=2m

BRIDGE_POSTGRES_USER=bridge
BRIDGE_POSTGRES_PASSWORD=
BRIDGE_POSTGRES_DB=bridge

# Dujiao-Next integration. The channel key/secret are created in the Dujiao
# admin panel after bootstrap and then written into this file.
DUJIAO_BASE_URL=http://dujiao-next:8080
DUJIAO_CHANNEL_KEY=
DUJIAO_CHANNEL_SECRET=
DUJIAO_POSTGRES_USER=dujiao
DUJIAO_POSTGRES_PASSWORD=
DUJIAO_POSTGRES_DB=dujiao
DUJIAO_REDIS_PASSWORD=
DUJIAO_APP_SECRET=
DUJIAO_JWT_SECRET=
DUJIAO_USER_JWT_SECRET=
DUJIAO_ADMIN_USERNAME=xddadmin
DUJIAO_ADMIN_PASSWORD=
DUJIAO_ADMIN_PATH=

# Dujiao-Next is intentionally pinned to an immutable multi-architecture image.
# This value is not changed by application releases.
DUJIAO_IMAGE=dujiaonext/dujiao-next@sha256:45afd5926c9df3a119caee20259242c107d7ce5e8c36dd40a8a0372c4d9730a5

LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE_NAME=sub2api
LOG_ENV=production
LOG_CALLER=true
LOG_STACKTRACE_LEVEL=error
LOG_OUTPUT_TO_STDOUT=true
LOG_OUTPUT_TO_FILE=false

# Optional GitHub token for release update checks; leave blank unless needed.
UPDATE_GITHUB_TOKEN=

# Host-side deployment policy.
DEPLOY_HEALTH_TIMEOUT_SECONDS=300
DEPLOY_LOCK_TIMEOUT_SECONDS=300
BACKUP_RETENTION_DAYS=14
SMOKE_TEST_RETRIES=18
