# Production runtime configuration for api.xddapi.org.uk.
# bootstrap-server.sh copies this file to .env and fills generated secrets.
# Never commit the real .env.

PUBLIC_DOMAIN=api.xddapi.org.uk
TZ=Asia/Shanghai
SERVER_MODE=release
RUN_MODE=standard
SERVER_FRONTEND_URL=https://api.xddapi.org.uk
SERVER_TRUSTED_PROXIES=172.30.0.10/32
SECURITY_TRUST_FORWARDED_IP_FOR_API_KEY_ACL=false

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=300
DATABASE_MAX_OPEN_CONNS=200
DATABASE_MAX_IDLE_CONNS=80
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=32

ADMIN_EMAIL=admin@xddapi.org.uk
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=

LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE_NAME=sub2api
LOG_ENV=production
LOG_CALLER=true
LOG_STACKTRACE_LEVEL=error
LOG_OUTPUT_TO_STDOUT=true
LOG_OUTPUT_TO_FILE=false

# Optional GitHub token for release update checks; leave blank unless needed.
UPDATE_GITHUB_TOKEN=

# Host-side deployment policy.
DEPLOY_HEALTH_TIMEOUT_SECONDS=300
DEPLOY_LOCK_TIMEOUT_SECONDS=300
BACKUP_RETENTION_DAYS=14
SMOKE_TEST_RETRIES=18
